rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.email == 'seanrabwet@gmail.com');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Products: Public can read active products. Admin has full access.
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Categories: Public can read active categories. Admin has full access.
    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Delivery Zones: Public can read all zones for checkout fee calculation. Admin can edit.
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners: Public can read active banners. Admin can edit.
    match /banners/{bannerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Settings: Public can read general settings (free delivery thresholds). Admin can edit.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: Users can read and update their own document. Admin can read all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // Carts: Users can read and write only their own cart.
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Orders: Users can read their own orders.
    // Customers can create orders but cannot set paymentStatus to 'paid' or modify existing orders.
    match /orders/{orderId} {
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if true; // Allows guest and logged-in checkouts
      allow update: if isAdmin(); // Only admin or Cloud Functions can update fulfillment and payment statuses
      allow delete: if isAdmin();
    }
  }
}
